      <short value="Practitioner" />
      <definition value="Details of a natural person who provides professional healthcare services. (NEN7540:2024)" />
      <alias value="Zorgverlener" />
      <constraint>
        <key value="name-or-identifier" />
        <severity value="error" />
        <human value="identifier or name SHALL be present (from http://hl7.eu/fhir/base/StructureDefinition/practitioner-eu)" />
        <expression value="identifier.exists() or name.exists()" />
      </constraint>
    </element>
    <element id="Practitioner.identifier">
