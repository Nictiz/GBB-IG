      {
        "reference": {
          "reference": "StructureDefinition/nl-core-Address"
        },
        "description": "Address information includes data where a person resides (temporarily, permanently) or where a building is located.",
        "exampleBoolean": false,
        "name": "nl core Address"
      },
      {
        "reference": {
          "reference": "StructureDefinition/nl-core-AllergyIntolerance"
        },
        "description": "Clinical assessment of an individual's propensity to experience a harmful or adverse physiological reaction upon exposure, or repeated exposure, to a substance. Substances include, among others, a therapeutic substance administered correctly and in the appropriate dosage for the individual (side effects); food; material derived from plants or animals; or venom from insect bites.",
        "exampleBoolean": false,
        "name": "nl core AllergyIntolerance"
      },
      {
        "reference": {
          "reference": "StructureDefinition/nl-core-Condition"
        },
        "exampleBoolean": false,
        "name": "nl core Condition"
      },
      {
        "reference": {
          "reference": "StructureDefinition/nl-core-ContactPoint"
        },
        "description": "Contact information includes a person's telephone numbers and e-mail addresses.",
        "exampleBoolean": false,
        "name": "nl core ContactPoint"
      },
      {
        "reference": {
          "reference": "StructureDefinition/nl-core-Device"
        },
        "description": "The concept contains the properties of a variety of implants, devices and aids that are patient-related and support the healthcare process. It covers medical and non-medical devices, ranging from simple aids and implants to equipment and software.",
        "exampleBoolean": false,
        "name": "nl core Device"
      },
      {
        "reference": {
          "reference": "StructureDefinition/nl-core-DeviceUse"
        },
        "description": "FHIR R4 profile for the generic building block DeviceUse.",
        "exampleBoolean": false,
        "name": "nl core DeviceUse"
      },
      {
        "reference": {
          "reference": "StructureDefinition/nl-core-HumanName"
        },
        "description": "A person's official name information, including given names, last name and possibly the partner's last name.",
        "exampleBoolean": false,
        "name": "nl core HumanName"
      },
      {
        "reference": {
          "reference": "StructureDefinition/nl-core-Location"
        },
        "description": "A location includes both temporary locations (a place used for healthcare without prior designation or authorisation) and special, formally designated locations. Locations may be private, public, mobile or fixed, and vary in size from small freezers to entire hospital buildings or multi-storey car parks.",
        "exampleBoolean": false,
        "name": "nl core Location"
      },
      {
        "reference": {
          "reference": "StructureDefinition/nl-core-Organization"
        },
        "description": "A healthcare provider is an organization that offers and provides medical, paramedic and/or nursing care to patients/clients. Examples include: hospitals, nursing homes, doctor’s offices.",
        "exampleBoolean": false,
        "name": "nl core Organization"
      },
      {
        "reference": {
          "reference": "StructureDefinition/nl-core-Patient"
        },
        "description": "A person who receives medical, psychological, paramedical or nursing care. In some care settings, the term client or participant is used instead of the term patient.\r\nNationality is used as an indication of the country of citizenship. \r\nMarital status is a person’s formal position as defined by the Dutch civil code. There is a distinction between marriage and civil union.\r\nLinguistic proficiency is the ability to express oneself in a certain language and understand statements made in that language. This includes both oral and written communication.",
        "exampleBoolean": false,
        "name": "nl core Patient"
      },
      {
        "reference": {
          "reference": "StructureDefinition/nl-core-Practitioner"
        },
        "description": "Gegevens van een natuurlijke persoon die beroepsmatig zorg verleent (NEN7540:2024)",
        "exampleBoolean": false,
        "name": "nl core Practitioner"
      },
      {
        "reference": {
          "reference": "StructureDefinition/nl-core-PractitionerRole"
        },
        "description": "A health professional is a person who is authorized to perform actions in the field of individual healthcare.",
        "exampleBoolean": false,
        "name": "nl core PractitionerRole"
      },
      {
        "reference": {
          "reference": "StructureDefinition/nl-core-Procedure"
        },
        "description": "The concept Procedure describes therapeutic or diagnostic procedure undergone by the patient or which the patient will undergo. The concept can describe in the right context historical, future as well as advised procedures.A procedure can be a simple blood pressure measurement, but also a complex heart surgery.In some care settings, the term treatment t is used instead of the term procedure.",
        "exampleBoolean": false,
        "name": "nl core Procedure"
      },
